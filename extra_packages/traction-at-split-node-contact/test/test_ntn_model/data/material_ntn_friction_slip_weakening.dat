user parameters [
     # BOUNDARY CONDITIONS
     top_traction  = [ 0 , -1e6 ] 
     bot_traction  = [ 0 ,  0 ] 
          
     # TIME
     simulation_time  = 1e-4
     time_step_factor = 0.1
]

